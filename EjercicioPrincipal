
import matplotlib.pyplot as plt


vertices = [
    (0, 0),  # A
    (8, 0),  # B
    (8, 6),  # C
    (4, 3),  # D
    (0, 6)   # E
]

nombres = ["A", "B", "C", "D", "E"]



def determinante(a, b, c):
    return ((b[0] - a[0]) * (c[1] - a[1]) -
            (b[1] - a[1]) * (c[0] - a[0]))


def clasificar_vertices(vertices):
    n = len(vertices)

    print("\nCLASIFICACION DE VERTICES")
    print("-------------------------")

    for i in range(n):
        anterior = vertices[(i - 1) % n]
        actual = vertices[i]
        siguiente = vertices[(i + 1) % n]

        det = determinante(anterior, actual, siguiente)

        if det > 0:
            tipo = "Convexo"
        elif det < 0:
            tipo = "Concavo"
        else:
            tipo = "Colineal"

        print(f"Vertice {nombres[i]}: "
              f"Determinante = {det} -> {tipo}")




def calcular_triangulacion(n):
    triangulos = n - 2
    diagonales = n - 3
    diagonales_totales = n * (n - 3) // 2

    print("\nCALCULO DE TRIANGULACION")
    print("------------------------")
    print("Numero de vertices:", n)
    print("Triangulos necesarios:", triangulos)
    print("Diagonales internas necesarias:", diagonales)
    print("Diagonales posibles en total:", diagonales_totales)




def punto_en_triangulo(p, a, b, c):
    d1 = determinante(a, b, p)
    d2 = determinante(b, c, p)
    d3 = determinante(c, a, p)

    return ((d1 >= 0 and d2 >= 0 and d3 >= 0) or
            (d1 <= 0 and d2 <= 0 and d3 <= 0))




def ear_clipping(vertices):
    puntos = vertices.copy()
    triangulos = []

    while len(puntos) > 3:
        encontrado = False
        n = len(puntos)

        for i in range(n):

            anterior = puntos[(i - 1) % n]
            actual = puntos[i]
            siguiente = puntos[(i + 1) % n]

            # Verificar que el giro sea convexo
            det = determinante(anterior, actual, siguiente)

            if det <= 0:
                continue

            # Verificar que no haya otro vertice
            # dentro o sobre el triangulo candidato
            es_oreja = True

            for j in range(n):
                if j == i or j == (i - 1) % n or j == (i + 1) % n:
                    continue

                if punto_en_triangulo(
                    puntos[j], anterior, actual, siguiente
                ):
                    es_oreja = False
                    break

            if es_oreja:
                triangulos.append(
                    (anterior, actual, siguiente)
                )

                print("\nOREJA ENCONTRADA:", actual)
                print("Triangulo retirado:",
                      anterior, actual, siguiente)

                # Retirar el vertice central
                puntos.pop(i)

                encontrado = True
                break

        if not encontrado:
            raise ValueError(
                "No se encontro una oreja valida."
            )

    # Agregar el ultimo triangulo
    triangulos.append(tuple(puntos))

    return triangulos




def dibujar_triangulacion(vertices, triangulos):

    plt.figure(figsize=(8, 6))

    # Dibujar contorno del terreno
    x = [p[0] for p in vertices] + [vertices[0][0]]
    y = [p[1] for p in vertices] + [vertices[0][1]]

    plt.plot(x, y, "b-", linewidth=2, label="Terreno")

    # Dibujar vertices y nombres
    for i, punto in enumerate(vertices):
        plt.scatter(punto[0], punto[1], color="red")
        plt.text(punto[0] + 0.15,
                 punto[1] + 0.15,
                 nombres[i],
                 fontsize=12)

    # Dibujar triangulos
    for triangulo in triangulos:
        tx = [p[0] for p in triangulo] + [triangulo[0][0]]
        ty = [p[1] for p in triangulo] + [triangulo[0][1]]

        plt.plot(tx, ty, "g--", linewidth=2)

    plt.title("Triangulacion del terreno - Ear Clipping")
    plt.xlabel("Coordenada X")
    plt.ylabel("Coordenada Y")
    plt.grid(True)
    plt.axis("equal")
    plt.legend()
    plt.show()



clasificar_vertices(vertices)

calcular_triangulacion(len(vertices))

triangulos = ear_clipping(vertices)

print("\nTRIANGULOS FINALES")
for i, t in enumerate(triangulos, 1):
    print(f"Triangulo {i}: {t}")

print("\nTotal de triangulos:", len(triangulos))

dibujar_triangulacion(vertices, triangulos)
